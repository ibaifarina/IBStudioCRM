# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
.nyc_output

# next.js
/.next/
/out/

# production
/build

# caches
.cache/
.turbo/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel/

# supabase local development
/supabase/.branches/
/supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

# Legacy local database (kept only as a recoverable local backup)
/data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
